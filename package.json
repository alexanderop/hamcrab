{
  "name": "hamcrab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint src tests --deny-warnings && prettier --check .",
    "test:e2e": "bddgen && playwright test --project chromium",
    "test:compat": "bddgen && playwright test",
    "verify": "pnpm lint && pnpm build && pnpm test:e2e",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@lucide/vue": "^1.51.0",
    "dexie": "^4.2.0",
    "three": "^0.180.0",
    "vue": "^3.5.42",
    "workbox-window": "^7.4.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "oxlint": "^1.80.0",
    "playwright-bdd": "9.2.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^3.1.1"
  },
  "description": "A local-first 3D pocket pet in a nostalgic handheld PWA."
}
